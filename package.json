{
  "name": "saga",
  "displayName": "Saga",
  "description": "AI-powered agile planning for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "saga.init",
        "title": "Saga: Init",
        "category": "Saga"
      },
      {
        "command": "saga.addContextFile",
        "title": "Saga: Add Context File",
        "category": "Saga",
        "icon": "$(add)"
      },
      {
        "command": "saga.generateEpics",
        "title": "Saga: Generate Epics",
        "category": "Saga",
        "icon": "$(sparkle)"
      },
      {
        "command": "saga.generateStoriesForEpic",
        "title": "Saga: Generate Stories for Epic",
        "category": "Saga",
        "icon": "$(sparkle)"
      },
      {
        "command": "saga.validateStories",
        "title": "Saga: Validate Stories",
        "category": "Saga",
        "icon": "$(check-all)"
      },
      {
        "command": "saga.openStory",
        "title": "Saga: Open Story",
        "category": "Saga"
      },
      {
        "command": "saga.addInlineContext",
        "title": "Saga: Add Inline Context",
        "category": "Saga",
        "icon": "$(edit)"
      },
      {
        "command": "saga.deleteEpic",
        "title": "Saga: Delete Epic",
        "category": "Saga",
        "icon": "$(trash)"
      },
      {
        "command": "saga.deleteStory",
        "title": "Saga: Delete Story",
        "category": "Saga",
        "icon": "$(trash)"
      },
      {
        "command": "saga.clearStoriesForEpic",
        "title": "Saga: Clear Stories for Epic",
        "category": "Saga"
      },
      {
        "command": "saga.clearEpics",
        "title": "Saga: Clear Epics",
        "category": "Saga"
      },
      {
        "command": "saga.cleanUp",
        "title": "Saga: Clean Up",
        "category": "Saga"
      },
      {
        "command": "saga.pushEpic",
        "title": "Saga: Push Epic to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.pushStory",
        "title": "Saga: Push Story to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.pushAll",
        "title": "Saga: Push All to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.sync",
        "title": "Saga: Sync with Tracker",
        "category": "Saga",
        "icon": "$(sync)"
      },
      {
        "command": "saga.openSettings",
        "title": "Saga: Open Settings",
        "category": "Saga",
        "icon": "$(settings-gear)"
      },
      {
        "command": "saga.testGeneration",
        "title": "Saga: Test Generation",
        "category": "Saga"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "saga",
          "title": "Saga",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "saga": [
        {
          "id": "saga.storiesView",
          "name": "Epics & Stories",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "saga.contextView",
          "name": "Context Files",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "saga.storiesView",
        "contents": "Saga is not initialized in this workspace.\n\n[Initialize Saga](command:saga.init)\n\nThis will create a .saga/ folder with a default config.",
        "when": "workspaceFolderCount > 0 && !saga.initialized"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "saga.addContextFile",
          "when": "view == saga.contextView",
          "group": "navigation"
        },
        {
          "command": "saga.addInlineContext",
          "when": "view == saga.contextView",
          "group": "navigation"
        },
        {
          "command": "saga.generateEpics",
          "when": "view == saga.storiesView",
          "group": "navigation"
        },
        {
          "command": "saga.pushAll",
          "when": "view == saga.storiesView",
          "group": "navigation"
        },
        {
          "command": "saga.sync",
          "when": "view == saga.storiesView",
          "group": "navigation"
        },
        {
          "command": "saga.validateStories",
          "when": "view == saga.storiesView",
          "group": "navigation"
        },
        {
          "command": "saga.openSettings",
          "when": "view == saga.storiesView || view == saga.contextView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "saga.generateStoriesForEpic",
          "when": "viewItem == sagaEpic",
          "group": "inline"
        },
        {
          "command": "saga.pushEpic",
          "when": "viewItem == sagaEpic",
          "group": "inline"
        },
        {
          "command": "saga.deleteEpic",
          "when": "viewItem == sagaEpic",
          "group": "saga@1"
        },
        {
          "command": "saga.clearStoriesForEpic",
          "when": "viewItem == sagaEpic",
          "group": "saga@2"
        },
        {
          "command": "saga.pushStory",
          "when": "viewItem == sagaStory",
          "group": "inline"
        },
        {
          "command": "saga.deleteStory",
          "when": "viewItem == sagaStory",
          "group": "saga@1"
        }
      ],
      "explorer/context": [
        {
          "command": "saga.addContextFile",
          "group": "saga@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "compile:webview": "vite build",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "vite build --watch",
    "package": "npm run check-types && npm run lint && npm run compile:webview && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@cucumber/gherkin": "^41.0.0",
    "handlebars": "^4.7.9",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
