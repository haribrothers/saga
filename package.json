{
  "name": "saga",
  "displayName": "Saga",
  "description": "AI-generated, INVEST-compliant agile stories synced with Jira/Azure DevOps and version-controlled next to your code.",
  "version": "0.0.1",
  "publisher": "haribrothers",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/haribrothers/saga.git"
  },
  "homepage": "https://haribrothers.github.io/saga/",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agile",
    "user stories",
    "epics",
    "invest",
    "gherkin",
    "acceptance criteria",
    "jira",
    "azure devops",
    "backlog",
    "planning",
    "ai",
    "copilot",
    "product management",
    "scrum",
    "agents.md"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "saga.init",
        "title": "Init",
        "category": "Saga"
      },
      {
        "command": "saga.gettingStarted",
        "title": "Getting Started",
        "category": "Saga",
        "icon": "$(rocket)"
      },
      {
        "command": "saga.addContextFile",
        "title": "Add Context File",
        "category": "Saga",
        "icon": "$(add)"
      },
      {
        "command": "saga.generateEpics",
        "title": "Generate Epics",
        "category": "Saga",
        "icon": "$(sparkle)"
      },
      {
        "command": "saga.generateStoriesForEpic",
        "title": "Generate Stories for Epic",
        "category": "Saga",
        "icon": "$(sparkle)"
      },
      {
        "command": "saga.validateStories",
        "title": "Validate Stories",
        "category": "Saga",
        "icon": "$(check-all)"
      },
      {
        "command": "saga.openStory",
        "title": "Open Story",
        "category": "Saga"
      },
      {
        "command": "saga.editEpic",
        "title": "Edit Epic",
        "category": "Saga",
        "icon": "$(edit)"
      },
      {
        "command": "saga.addInlineContext",
        "title": "Add Inline Context",
        "category": "Saga",
        "icon": "$(edit)"
      },
      {
        "command": "saga.deleteEpic",
        "title": "Delete Epic",
        "category": "Saga",
        "icon": "$(trash)"
      },
      {
        "command": "saga.deleteStory",
        "title": "Delete Story",
        "category": "Saga",
        "icon": "$(trash)"
      },
      {
        "command": "saga.clearStoriesForEpic",
        "title": "Clear Stories for Epic",
        "category": "Saga",
        "icon": "$(clear-all)"
      },
      {
        "command": "saga.clearEpics",
        "title": "Clear Epics",
        "category": "Saga",
        "icon": "$(clear-all)"
      },
      {
        "command": "saga.cleanUp",
        "title": "Clean Up",
        "category": "Saga",
        "icon": "$(trash)"
      },
      {
        "command": "saga.pushEpic",
        "title": "Push Epic to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.pushStory",
        "title": "Push Story to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.pushAll",
        "title": "Push All to Tracker",
        "category": "Saga",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "saga.sync",
        "title": "Sync with Tracker",
        "category": "Saga",
        "icon": "$(sync)"
      },
      {
        "command": "saga.openSettings",
        "title": "Open Settings",
        "category": "Saga",
        "icon": "$(settings-gear)"
      },
      {
        "command": "saga.openDocumentation",
        "title": "Open Documentation",
        "category": "Saga",
        "icon": "$(question)"
      },
      {
        "command": "saga.moreActions",
        "title": "More Actions",
        "category": "Saga",
        "icon": "$(ellipsis)"
      },
      {
        "command": "saga.generateAgentPrompt",
        "title": "Generate Agent Prompt",
        "category": "Saga",
        "icon": "$(robot)"
      },
      {
        "command": "saga.generateAgentsMd",
        "title": "Generate AGENTS.md",
        "category": "Saga",
        "icon": "$(file-code)"
      },
      {
        "command": "saga.generateSubtasks",
        "title": "Generate Subtasks",
        "category": "Saga",
        "icon": "$(checklist)"
      },
      {
        "command": "saga.splitStory",
        "title": "Split Story",
        "category": "Saga",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "saga.exportBacklog",
        "title": "Export Backlog",
        "category": "Saga",
        "icon": "$(export)"
      },
      {
        "command": "saga.openContextFile",
        "title": "Open Context File",
        "category": "Saga"
      },
      {
        "command": "saga.openTemplate",
        "title": "Open Template",
        "category": "Saga",
        "icon": "$(files)"
      },
      {
        "command": "saga.resetTemplate",
        "title": "Reset Template",
        "category": "Saga",
        "icon": "$(discard)"
      },
      {
        "command": "saga.testGeneration",
        "title": "Test Generation",
        "category": "Saga"
      }
    ],
    "submenus": [
      {
        "id": "saga.moreActionsMenu",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      },
      {
        "id": "saga.epicMoreActionsMenu",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      },
      {
        "id": "saga.storyMoreActionsMenu",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "saga",
          "title": "Saga",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "saga": [
        {
          "id": "saga.storiesView",
          "name": "Epics & Stories",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "saga.contextView",
          "name": "Context Files",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "saga.storiesView",
        "contents": "Saga is not initialized in this workspace.\n\n[Initialize Saga](command:saga.init)\n\nThis will create a .saga/ folder with a default config.",
        "when": "workspaceFolderCount > 0 && !saga.initialized"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "saga.addContextFile",
          "when": "view == saga.contextView",
          "group": "navigation"
        },
        {
          "command": "saga.addInlineContext",
          "when": "view == saga.contextView",
          "group": "navigation"
        },
        {
          "command": "saga.generateEpics",
          "when": "view == saga.storiesView",
          "group": "navigation@1"
        },
        {
          "command": "saga.pushAll",
          "when": "view == saga.storiesView",
          "group": "navigation@2"
        },
        {
          "command": "saga.sync",
          "when": "view == saga.storiesView",
          "group": "navigation@3"
        },
        {
          "command": "saga.validateStories",
          "when": "view == saga.storiesView",
          "group": "navigation@4"
        },
        {
          "command": "saga.openSettings",
          "when": "view == saga.storiesView",
          "group": "navigation@5"
        },
        {
          "command": "saga.openDocumentation",
          "when": "view == saga.storiesView",
          "group": "navigation@6"
        },
        {
          "command": "saga.openSettings",
          "when": "view == saga.contextView",
          "group": "navigation"
        },
        {
          "submenu": "saga.moreActionsMenu",
          "when": "view == saga.storiesView",
          "group": "navigation@7"
        }
      ],
      "saga.moreActionsMenu": [
        {
          "command": "saga.generateAgentsMd",
          "group": "1_generate@1"
        },
        {
          "command": "saga.exportBacklog",
          "group": "1_generate@2"
        },
        {
          "command": "saga.gettingStarted",
          "group": "2_onboarding@1"
        },
        {
          "command": "saga.openTemplate",
          "group": "3_templates@1"
        },
        {
          "command": "saga.resetTemplate",
          "group": "3_templates@2"
        },
        {
          "command": "saga.clearEpics",
          "group": "4_destructive@1"
        },
        {
          "command": "saga.cleanUp",
          "group": "4_destructive@2"
        }
      ],
      "view/item/context": [
        {
          "command": "saga.generateStoriesForEpic",
          "when": "viewItem == sagaEpic",
          "group": "inline@1"
        },
        {
          "command": "saga.pushEpic",
          "when": "viewItem == sagaEpic",
          "group": "inline@2"
        },
        {
          "submenu": "saga.epicMoreActionsMenu",
          "when": "viewItem == sagaEpic",
          "group": "inline@3"
        },
        {
          "command": "saga.pushStory",
          "when": "viewItem == sagaStory",
          "group": "inline@1"
        },
        {
          "command": "saga.generateAgentPrompt",
          "when": "viewItem == sagaStory",
          "group": "inline@2"
        },
        {
          "submenu": "saga.storyMoreActionsMenu",
          "when": "viewItem == sagaStory",
          "group": "inline@3"
        }
      ],
      "saga.epicMoreActionsMenu": [
        {
          "command": "saga.editEpic",
          "group": "1_manage@1"
        },
        {
          "command": "saga.clearStoriesForEpic",
          "group": "1_manage@2"
        },
        {
          "command": "saga.deleteEpic",
          "group": "2_destructive@1"
        }
      ],
      "saga.storyMoreActionsMenu": [
        {
          "command": "saga.generateSubtasks",
          "group": "1_generate@1"
        },
        {
          "command": "saga.splitStory",
          "group": "1_generate@2"
        },
        {
          "command": "saga.deleteStory",
          "group": "2_destructive@1"
        }
      ],
      "explorer/context": [
        {
          "command": "saga.addContextFile",
          "group": "saga@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "compile:webview": "vite build",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "vite build --watch",
    "package": "npm run check-types && npm run lint && npm run compile:webview && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@cucumber/gherkin": "^41.0.0",
    "@google/genai": "^2.10.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "mammoth": "^1.12.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
